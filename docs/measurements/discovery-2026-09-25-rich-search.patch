+fn attach_schema(row: &mut Value, entry: &IndexEntry, registered: &[Tool], budget: &mut usize) {
+    let description = describe(
+        &DescribeArguments {
+            name: entry.tool.clone(),
+            detail: None,
+        },
+        registered,
+    )
+    .expect("index entries have registered descriptions");
+    let schema = &description["input_schema"];
+    let bytes = serde_json::to_vec(schema)
+        .expect("JSON schema encodes")
+        .len();
+    if bytes <= *budget {
+        *budget -= bytes;
+        row["input_schema"] = schema.clone();
+    } else {
+        row["schema_omitted"] = json!(true);
+    }
+}
