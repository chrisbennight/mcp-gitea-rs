GITEA_MCP_UPSTREAM_URL=https://gitea.example.com
GITEA_MCP_SERVICE_TOKEN=replace-with-service-token
# Optional token administration: configure both values or leave both unset.
# GITEA_MCP_TOKEN_USERNAME=replace-with-token-lifecycle-user
# GITEA_MCP_TOKEN_PASSWORD=replace-with-token-lifecycle-password
GITEA_MCP_GATEWAY_BEARER_CURRENT=replace-with-at-least-32-byte-bearer
# GITEA_MCP_GATEWAY_BEARER_PREVIOUS=replace-with-previous-bearer
GITEA_MCP_HOST=0.0.0.0
GITEA_MCP_PORT=8000
GITEA_MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000
GITEA_MCP_HTTP_TIMEOUT_SECONDS=30
GITEA_MCP_MAX_REQUEST_BYTES=8388608
GITEA_MCP_MAX_CONCURRENT_REQUESTS=8
# Enables MCP file uploads for repository.secret.set_from_file. This bare
# HTTP(S) origin must be reachable from the MCP gateway.
# GITEA_MCP_FILE_PUBLIC_ORIGIN=http://mcp-gitea-rs:8000
GITEA_MCP_LOG_LEVEL=info
